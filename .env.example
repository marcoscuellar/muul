# --- AI generation (serverless /api/complete) ---
ANTHROPIC_API_KEY=sk-ant-...
# Optional: override the model (default: claude-sonnet-4-6).
# AI_MODEL=claude-sonnet-4-6
# Optional: point the frontend at a different completion endpoint (default /api/complete).
# VITE_AI_ENDPOINT=/api/complete

# --- Accounts + durable per-user storage (Supabase) ---
# Set these to enable sign-in and cross-device cloud sync. Leave them unset to
# run in local-only mode (localStorage, no accounts). Find them in your Supabase
# project: Settings -> API. The anon key is safe to expose in the browser; RLS
# (see supabase/schema.sql) is what protects each account's data.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
