# Backend AI key for the /api/complete serverless function.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (default: claude-sonnet-4-6).
# AI_MODEL=claude-sonnet-4-6

# Optional: point the frontend at a different completion endpoint.
# Default is /api/complete (served by `vercel dev` or the deployed function).
# VITE_AI_ENDPOINT=/api/complete
